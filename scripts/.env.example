# Morp open_lobby.js — monitor layout config
# Copy this file to .env and adjust to match your physical monitor setup.
#
# PRIMARY   = the monitor where windows open by default (x=0 in Windows)
# SECONDARY = the other monitor
#
# All values are physical pixels. To find exact values, run in PowerShell: (Run each line separately)
#   Add-Type -AssemblyName System.Windows.Forms
#   [System.Windows.Forms.Screen]::AllScreens | Select-Object DeviceName, Bounds, Primary
# Use X/Y/Width/Height from Bounds. The Primary monitor is always X=0, Y=0.
# Negative SECONDARY_X = secondary is left of primary.
# Non-zero SECONDARY_Y = monitors aren't top-aligned (must be set correctly).

PRIMARY_W=1920
PRIMARY_H=1080
PRIMARY_X=0
PRIMARY_Y=0

SECONDARY_W=1920
SECONDARY_H=1080
# Negative = secondary is left of primary; positive = secondary is right of primary.
SECONDARY_X=-1920
SECONDARY_Y=0
